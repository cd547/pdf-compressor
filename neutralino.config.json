{
  "applicationId": "com.pdfcompressor.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 54419,
  "url": "/resources/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one",
  "nativeAllowList": [
    "os.spawnProcess",
    "os.execCommand",
    "os.getPath",
    "os.getEnv",
    "os.showOpenDialog",
    "os.showFolderDialog",
    "os.showSaveDialog",
    "events.*",
    "filesystem.getStats",
    "filesystem.readFile",
    "filesystem.writeFile",
    "filesystem.mkdir",
    "filesystem.remove",
    "filesystem.readdir",
    "window.*",
    "storage.*",
    "app.*"
  ],
  "globalVariables": {
    "APP_NAME": "PDF Compressor"
  },
  "modes": {
    "window": {
      "title": "PDF 压缩工具",
      "width": 1100,
      "height": 760,
      "minWidth": 900,
      "minHeight": 640,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "pdf-compressor",
    "extensions": [],
    "extensionsPath": "extensions",
    "resourcesPath": "resources",
    "clientLibrary": "resources/js/neutralino.js",
    "binaryVersion": "5.4.0",
    "clientVersion": "5.4.0",
    "distributionPath": "dist"
  }
}
